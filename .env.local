#localhost
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=Ayan@1012
MYSQL_PORT=3306
MYSQL_DATABASE=omni-channel

# ── VoxAgent app settings ────────────────────────────────────────────────────
# Port the API server listens on (the dashboard is started with PORT=8678).
PORT=8677

# Signs the login session cookie.
SESSION_SECRET=78745b8c49315a5c633ef93822f27c426287164049fc429c73f13de02f4415cf

# Encrypts provider API keys (AES-256) before they are stored in the database.
PROVIDER_KEY_SECRET=016b4a39e73567dcbc2302e2a5111d050a7f21d8044701341893018829e5941d

# "development" gives readable colour logs; "production" hardens the cookie.
NODE_ENV=development

# ── Optional: AI provider keys ───────────────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPGRAM_API_KEY=
# OLLAMA_API_URL=http://localhost:11434


ADMIN_IDS=ayan@multycomm.com,aveek@multycomm.com
ADMIN_PASSWORD=WELcome@1234


BACKEND_URL=https://maveai.voicemeetme.net:8677/

# The dashboard's /api proxy dials this instead of BACKEND_URL. Needed while the
# public hostname does not resolve to the machine the API server runs on.
API_PROXY_TARGET=https://localhost:8677
FRONTEND_URL=https://maveai.voicemeetme.net:8678/
# ── TLS ──────────────────────────────────────────────────────────────────────
# Both servers read privkey.pem + fullchain.pem from the workspace `ssl/` folder.
# SSL_DIR overrides that location; ENABLE_HTTPS=false forces plain HTTP.
SSL_DIR=/Users/mac/Desktop/Omni-Channel-Bot/ssl
ENABLE_HTTPS=true
